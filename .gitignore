# Entornos y temporales de Python
__pycache__/
*.py[cod]
.venv/
venv/
.runtime-deps/
*.pkl
*.npz
*.tmp
*.part

# Videos fuente: se conserva solo el clip sintetico pequeno de prueba.
inputs/*
!inputs/synthetic.mp4

# Resultados regenerables y artefactos de despliegue. Los fixtures versionados
