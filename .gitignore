outputs/*

# Fixtures generados por la suite Python para la suite JS (E-07)
tests/fixtures/slots-generated/
tests/fixtures/overlay-generated/

# Temporales del sistema y editores
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# Config local de Claude Code (no compartida)
.claude/settings.local.json
